{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://b2runclub-backend-rho.vercel.app/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://b2runclub-backend-rho.vercel.app/uploads/:path*"
    },
    {
      "source": "/health",
      "destination": "https://b2runclub-backend-rho.vercel.app/health"
    }
  ]
}