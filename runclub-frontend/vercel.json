{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://REPLACE-WITH-YOUR-BACKEND-HOST/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://REPLACE-WITH-YOUR-BACKEND-HOST/uploads/:path*"
    },
    {
      "source": "/health",
      "destination": "https://REPLACE-WITH-YOUR-BACKEND-HOST/health"
    }
  ]
}
